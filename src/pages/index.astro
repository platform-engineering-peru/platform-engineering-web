---
// GitHub Pages no permite redirecciones de servidor: se detecta el idioma
// del navegador en cliente y se redirige, con fallback al idioma por defecto.
import { defaultLang, locales, localizePath } from '@i18n/index';

const fallback = localizePath(defaultLang);
const targets = Object.fromEntries(locales.map((l) => [l, localizePath(l)]));
---

<!doctype html>
<html lang={defaultLang}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${fallback}`} />
    <link rel="canonical" href={fallback} />
    <script is:inline define:vars={{ targets, fallback }}>
      const preferred = (navigator.languages || [navigator.language])
        .map((l) => l.slice(0, 2).toLowerCase())
        .find((l) => l in targets);
      location.replace(preferred ? targets[preferred] : fallback);
    </script>
  </head>
  <body>
    <a href={fallback}>Continuar / Continue</a>
  </body>
</html>
