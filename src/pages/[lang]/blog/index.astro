---
import BaseLayout from '@layouts/BaseLayout.astro';
import BlogList from '@modules/blog/BlogList.astro';
import {getLangPaths,useTranslations,type Lang} from '@i18n/index';
export const getStaticPaths=getLangPaths;
const lang=Astro.params.lang as Lang;
const t=useTranslations(lang);
---
<BaseLayout lang={lang} title={t('blog.pageTitle')} description={t('blog.lead')}><BlogList lang={lang}/></BaseLayout>
