---
import BaseLayout from "@layouts/BaseLayout.astro";
import EditorialHome from "@modules/home/EditorialHome.astro";
import { getLangPaths, localizePath, type Lang } from "@i18n/index";
import { organizationLd } from "@lib/structured-data";

export const getStaticPaths = getLangPaths;

const lang = Astro.params.lang as Lang;
const jsonLd = organizationLd(
  lang,
  Astro.site!,
  new URL(localizePath(lang), Astro.site).href,
);
---

<BaseLayout lang={lang} jsonLd={jsonLd} editorial>
  <EditorialHome lang={lang} />
</BaseLayout>
