---
import BaseLayout from '@layouts/BaseLayout.astro';
import { CommunityContent } from '@modules/community';
import { getLangPaths, useTranslations, type Lang } from '@i18n/index';

export const getStaticPaths = getLangPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('nav.community')} description={t('community.lead')}>
  <CommunityContent lang={lang} />
</BaseLayout>
