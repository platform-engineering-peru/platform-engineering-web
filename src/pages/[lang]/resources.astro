---
import BaseLayout from '@layouts/BaseLayout.astro';
import { ResourcesGrid } from '@modules/resources';
import { getLangPaths, useTranslations, type Lang } from '@i18n/index';

export const getStaticPaths = getLangPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('resources.title')} description={t('resources.lead')}>
  <ResourcesGrid lang={lang} />
</BaseLayout>
