---
import BaseLayout from '@layouts/BaseLayout.astro';
import CfpBand from '@components/layout/CfpBand.astro';
import { EventsList } from '@modules/events';
import { getLangPaths, useTranslations, type Lang } from '@i18n/index';

export const getStaticPaths = getLangPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('events.title')} description={t('events.lead')}>
  <EventsList lang={lang} />
  <CfpBand lang={lang} />
</BaseLayout>
