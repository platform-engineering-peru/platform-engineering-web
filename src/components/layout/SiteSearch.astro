---
import { resources } from "@data/resources";
import { events } from "@data/events";
import { organizers } from "@data/organizers";
import { localizePath, pick, type Lang } from "@i18n/index";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const en = lang === "en";
const entries = [
  ...[
    {title:"Branding",text:"Logo Ukuku identidad visual colores paleta brand kit assets manual",path:"/branding"},
    {title:"Partners",text:"Alianzas en construcción coming soon",path:"/partners"},
    {title:"Golden paths",text:"En construcción work in progress",path:"/golden-paths"},
    {title:en?"Get involved":"Participa",text:"En construcción work in progress",path:"/participate"},
    {title:en?"The team":"El equipo",text:"En construcción work in progress",path:"/team"},
    {title: "Memories", text: "Fotos videos recuerdos galería gallery", path: "/memories"},
    {title: en?"Opportunities":"Oportunidades laborales", text: "Jobs empleos trabajo vacantes roles", path: "/opportunities"},
    {title: "Ukuku", text: "Mascota oso anteojos golden paths mascot bear", path: "/mascot"},
    {
      title: en ? "Home" : "Inicio",
      text: en
        ? "Platform Engineering Peru community"
        : "Comunidad Platform Engineering Perú",
      path: "",
    },
    {
      title: en ? "Events" : "Encuentros",
      text: en
        ? "Meetups KubeFest workshops"
        : "Meetups KubeFest talleres eventos",
      path: "/events",
    },
    {
      title: en ? "Resource archive" : "Archivo de recursos",
      text: en
        ? "Library courses guides articles"
        : "Biblioteca cursos guías artículos",
      path: "/resources",
    },
    {
      title: en ? "Community" : "Comunidad",
      text: en
        ? "Organizers participation team"
        : "Organizadores participación equipo",
      path: "/community",
    },
  ].map((page) => ({
    title: page.title,
    text: page.text,
    href: localizePath(lang, page.path),
    kind: en ? "Section" : "Sección",
  })),
  ...events.map((e) => ({
    title: pick(e.title, lang),
    text: pick(e.description, lang),
    href: localizePath(lang, `/events/${e.slug}`),
    kind: en ? "Event" : "Encuentro",
  })),
  ...resources.map((r) => ({
    title: pick(r.title, lang),
    text: pick(r.description, lang),
    href: r.href,
    kind: en ? "Resource" : "Recurso",
  })),
  ...organizers.map((o) => ({
    title: o.name,
    text: o.role,
    href: `${localizePath(lang, "/community")}#team`,
    kind: en ? "Organizer" : "Organizador",
  })),
];
---

<dialog
  class="site-search"
  data-site-search
  data-entries={JSON.stringify(entries)}
  data-empty={
    en
      ? "No matches. Try another search."
      : "Sin coincidencias. Prueba otra búsqueda."
  }
  data-count-label={en ? "results" : "resultados"}
  data-count-singular={en ? "result" : "resultado"}
  aria-labelledby="site-search-title"
>
  <div class="site-search__top">
    <h2 id="site-search-title">
      {en ? "Find your next idea." : "Encuentra tu próxima idea."}
    </h2>
    <button
      type="button"
      data-search-close
      aria-label={en ? "Close search" : "Cerrar búsqueda"}
    >
      ×
    </button>
  </div>
  <label class="site-search__field">
    <svg
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
    >
      <circle cx="10.5" cy="10.5" r="6.5" />
      <path d="m16 16 5 5" />
    </svg>
    <span class="visually-hidden">
      {en
        ? "Search events, resources and people"
        : "Buscar encuentros, recursos y personas"}
    </span>
    <input
      type="search"
      data-site-query
      placeholder={
        en ? "Events, resources, people…" : "Encuentros, recursos, personas…"
      }
      autocomplete="off"
      autofocus
    />
  </label>
  <p class="site-search__count" data-site-result-count aria-live="polite"></p>
  <div class="site-search__results" data-site-results></div>
  <p class="site-search__hint">
    {en
      ? "↑ ↓ Navigate · Enter Open · Esc Close"
      : "↑ ↓ Navegar · Enter Abrir · Esc Cerrar"}
  </p>
</dialog>
<script>
  import "./site-search";
</script>
<style is:global>
  .site-search {
    margin: 12vh auto auto;
    padding: 26px;
    width: min(650px, calc(100% - 32px));
    max-height: 76vh;
    border: 1px solid var(--ed-line);
    border-radius: 12px;
    background: var(--ed-paper);
    color: var(--ed-ink);
    box-shadow: 0 25px 100px #0004;
  }
  .site-search::backdrop {
    background: #0c091d99;
    backdrop-filter: blur(8px);
  }
  .site-search__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 20px;
  }
  .site-search h2 {
    font-family: var(--font-display);
    font-size: 22px;
    letter-spacing: -0.04em;
    font-weight: 600;
  }
  .site-search__top button {
    width: 40px;
    height: 40px;
    border: 1px solid var(--ed-line);
    border-radius: 50%;
    background: transparent;
    color: var(--ed-ink);
    font-size: 24px;
    cursor: pointer;
    flex-shrink: 0;
  }
  .site-search__field {
    display: flex;
    gap: 12px;
    align-items: center;
    border: 1px solid var(--ed-line);
    border-radius: 6px;
    padding: 0 15px;
    background: var(--ed-soft);
  }
  .site-search__field:focus-within {
    outline: 2px solid var(--ed-violet);
    outline-offset: 2px;
  }
  .site-search__field svg {
    width: 19px;
    height: 19px;
    flex-shrink: 0;
    color: var(--ed-violet);
  }
  .site-search__field input {
    width: 100%;
    min-width: 0;
    border: 0;
    outline: none;
    background: transparent;
    padding: 17px 0;
    font: inherit;
    font-size: 16px;
    color: var(--ed-ink);
  }
  .site-search__count {
    font-size: 11px;
    color: var(--ed-muted);
    padding: 18px 0 9px;
  }
  .site-search__results {
    max-height: 42vh;
    overflow: auto;
    overscroll-behavior: contain;
  }
  .site-search__results a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    padding: 14px 12px;
    border-radius: 5px;
    color: var(--ed-ink);
  }
  .site-search__results a:hover,
  .site-search__results a:focus-visible {
    background: var(--ed-lilac);
  }
  .site-search__results a > span:first-child {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .site-search__results small {
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--ed-muted);
  }
  .site-search__results strong {
    font-size: 14px;
    font-weight: 500;
  }
  .site-search__hint {
    font-size: 10px;
    color: var(--ed-muted);
    border-top: 1px solid var(--ed-line);
    padding-top: 14px;
    margin-top: 10px;
  }
  .site-search__empty {
    padding: 30px 12px;
    font-size: 14px;
    color: var(--ed-muted);
  }
  @media (max-width: 640px) {
    .site-search {
      padding: 20px;
      margin-top: 7vh;
      max-height: 85vh;
    }
    .site-search h2 {
      font-size: 19px;
    }
    .site-search__results {
      max-height: 51vh;
    }
  }
</style>
