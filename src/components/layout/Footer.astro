---
import { localizePath, type Lang } from "@i18n/index";
import Logo from "@components/ui/Logo.astro";
import BrandIcon from "@components/ui/BrandIcon.astro";
import { communityLinks, contactEmail } from "@data/site";
import BearMascot from "@components/motion/BearMascot.astro";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const en = lang === "en";
---

<footer
  class="living-footer"
  aria-label={en ? "Community footer" : "Pie de página de la comunidad"}
>
  <BearMascot lang={lang} class="living-footer__bear" />
  <div class="living-footer__left">
    <span class="studio-pill">
      {en ? "Have something to share?" : "¿Algo que compartir?"}
    </span>
    <h2>
      {en ? "Great platforms." : "Grandes plataformas."}
      <br />
      {en ? "Even better people." : "Mejores personas."}
    </h2>
    <nav aria-label={en ? "Footer navigation" : "Navegación del pie"}>
      <a href={localizePath(lang)}>{en ? "Home" : "Inicio"}</a>
      <a href={localizePath(lang, "/events")}>
        {en ? "Gatherings" : "Encuentros"}
      </a>
      <a href={localizePath(lang, "/resources")}>
        {en ? "Resources" : "Recursos"}
      </a>
      <a href={localizePath(lang, "/community")}>
        {en ? "Community" : "Comunidad"}
      </a>
      <a href={localizePath(lang, "/memories")}>Memories</a>
      <a href={localizePath(lang, "/opportunities")}>{en?"Opportunities":"Oportunidades"}</a>
      <a href={localizePath(lang, "/mascot")}>{en?"Meet Ukuku":"Conoce a Ukuku"}</a>
      <a href={localizePath(lang, "/branding")}>Branding</a>
    </nav>
  </div>
  <a class="living-footer__logo" href={localizePath(lang)} data-tilt>
    <span class="tilt-surface"><Logo height={94} /></span>
  </a>
  <div class="living-footer__right">
    <span class="studio-pill">
      {en ? "Let’s build together" : "Hagamos comunidad"}
    </span>
    <h2>
      {en ? "Your next idea" : "Tu próxima idea"}
      <br />
      {en ? "starts with a hello." : "empieza con un hola."}
    </h2>
    <button type="button" class="living-footer__cta" data-join-open>
      {en ? "Join the community" : "Únete a la comunidad"}{" "}
      <span aria-hidden="true">↗</span>
    </button>
    <a href={`mailto:${contactEmail}`} class="living-footer__email">
      {contactEmail}
    </a>
    {communityLinks.linkedin && (
      <a
        href={communityLinks.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="living-footer__social"
        aria-label="LinkedIn"
      >
        <BrandIcon name="linkedin" /><span>LinkedIn</span>
      </a>
    )}
  </div>
  <div class="living-footer__base">
    <span>© {new Date().getFullYear()} Platform Engineering Perú</span>
    <a href={`${localizePath(lang, "/community")}#code-of-conduct`}>
      {en ? "Code of conduct" : "Código de conducta"}
    </a>
    <span>
      {en
        ? "Made of people. Made in Peru."
        : "Hecho de personas. Hecho en Perú."}
    </span>
  </div>
</footer>
