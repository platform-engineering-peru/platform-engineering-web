---
/** Logo completo; alterna la versión para fondo oscuro/claro según el tema. */
import { asset } from '@lib/assets';

interface Props {
  height?: number;
  alt?: string;
}

const { height = 44, alt = 'Platform Engineering Perú' } = Astro.props;
// Proporción de los PNG del sistema de diseño (1200×400).
const width = Math.round(height * 3);
---

<img class="logo-on-dark" src={asset('brand/official/logo-web-dark.svg')} alt={alt} width={width} height={height} />
<img class="logo-on-light" src={asset('brand/official/logo-web-light.svg')} alt={alt} width={width} height={height} />
