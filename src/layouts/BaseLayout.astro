---
import "../styles/global.css";
import "../modules/home/editorial.css";
import "../styles/studio.css";
import SiteSearch from "@components/layout/SiteSearch.astro";
import "../styles/refinement.css";
import SiteMotion from "@components/motion/SiteMotion.astro";
import Header from "@components/layout/Header.astro";
import Footer from "@components/layout/Footer.astro";
import JoinDialog from "@components/layout/JoinDialog.astro";
import {
  defaultLang,
  langCode,
  locales,
  useTranslations,
  switchLangPath,
  type Lang,
} from "@i18n/index";
import { asset } from "@lib/assets";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Páginas sin equivalente por idioma (404): sin canonical/hreflang y fuera del índice. */
  standalone?: boolean;
  /** Datos estructurados schema.org de la página. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  editorial?: boolean;
}

const {
  lang,
  title,
  description,
  standalone = false,
  jsonLd,
  editorial = true,
} = Astro.props;
const t = useTranslations(lang);
const pageTitle = title ? `${title} | ${t("site.title")}` : t("site.title");
const pageDescription = description ?? t("site.description");
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={langCode(lang)} data-editorial={editorial ? "" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Aplicar el tema guardado antes del primer render; el nuevo home inicia en claro. -->
    <script is:inline define:vars={{ editorial }}>
      try {
        const saved = localStorage.getItem("pe-theme");
        document.documentElement.dataset.theme =
          saved === "light" || saved === "dark"
            ? saved
            : editorial
              ? "light"
              : "dark";
      } catch {
        if (editorial) document.documentElement.dataset.theme = "light";
      }
    </script>
    <meta name="theme-color" content={editorial ? "#F0EEFA" : "#0B0820"} />
    {editorial && (
      <>
        <link
          rel="preload"
          href={asset("fonts/epilogue-variable.ttf")}
          as="font"
          type="font/ttf"
          crossorigin="anonymous"
        />
        <link
          rel="preload"
          href={asset("fonts/dm-sans-variable.ttf")}
          as="font"
          type="font/ttf"
          crossorigin="anonymous"
        />
      </>
    )}
    <link rel="icon" type="image/png" href={asset("favicon.png")} />
    <link rel="apple-touch-icon" href={asset("brand/official/apple-touch-icon.png")} />
    {!editorial && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
          rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap"
        />
      </>
    )}
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {standalone ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        {locales.map((l) => (
          <link
            rel="alternate"
            hreflang={langCode(l)}
            href={new URL(switchLangPath(Astro.url, l), Astro.site)}
          />
        ))}
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(switchLangPath(Astro.url, defaultLang), Astro.site)}
        />
      </>
    )}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t("site.title")} />
    {!standalone && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={new URL(asset("og.jpg"), Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:locale" content={langCode(lang).replace("-", "_")} />
    <link rel="sitemap" href={asset("sitemap-index.xml")} />
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body class:list={{ "site-editorial": editorial }}>
    {editorial && (
      <a class="ed-skip-link" href="#main-content">
        {lang === "en" ? "Skip to content" : "Ir al contenido"}
      </a>
    )}
    <Header lang={lang} />
    <main id="main-content">
      <slot />
    </main>
    <Footer lang={lang} />
    <JoinDialog lang={lang} />
    <SiteSearch lang={lang} />
    <SiteMotion />
  </body>
</html>
