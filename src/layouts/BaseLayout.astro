---
import '../styles/global.css';
import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import JoinDialog from '@components/layout/JoinDialog.astro';
import { defaultLang, langCode, locales, useTranslations, switchLangPath, type Lang } from '@i18n/index';
import { asset } from '@lib/assets';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Páginas sin equivalente por idioma (404): sin canonical/hreflang y fuera del índice. */
  standalone?: boolean;
  /** Datos estructurados schema.org de la página. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { lang, title, description, standalone = false, jsonLd } = Astro.props;
const t = useTranslations(lang);
const pageTitle = title ? `${title} | ${t('site.title')}` : t('site.title');
const pageDescription = description ?? t('site.description');
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={langCode(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Tema oscuro por defecto; se aplica antes de pintar para evitar parpadeo. -->
    <script is:inline>
      try {
        if (localStorage.getItem('pe-theme') === 'light') document.documentElement.dataset.theme = 'light';
      } catch {}
    </script>
    <meta name="theme-color" content="#0B0820" />
    <link rel="icon" type="image/png" href={asset('favicon.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap"
    />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {standalone ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        {locales.map((l) => (
          <link rel="alternate" hreflang={langCode(l)} href={new URL(switchLangPath(Astro.url, l), Astro.site)} />
        ))}
        <link rel="alternate" hreflang="x-default" href={new URL(switchLangPath(Astro.url, defaultLang), Astro.site)} />
      </>
    )}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t('site.title')} />
    {!standalone && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={new URL(asset('og.jpg'), Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:locale" content={langCode(lang).replace('-', '_')} />
    <link rel="sitemap" href={asset('sitemap-index.xml')} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <JoinDialog lang={lang} />
  </body>
</html>
