---
import AboutCommunity from "./AboutCommunity.astro";
import GlobalNetwork from "./GlobalNetwork.astro";
import Icon from "@components/ui/Icon.astro";

import type { IconName } from "@components/ui/icons";
import {
  localizePath,
  useTranslations,
  type Lang,
  type TranslationKey,
} from "@i18n/index";
import { communityLinks, globalLinks } from "@data/site";
import OrganizerCarousel from "./OrganizerCarousel.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

type Way = {
  icon: IconName;
  title: TranslationKey;
  body: TranslationKey;
  cta: TranslationKey;
  /** Enlace interno, externo (http o mailto), o `null` → abre el diálogo "Únete". */
  href: string | null;
};

const ways: Way[] = [
  {
    icon: "calendar",
    title: "community.attend.title",
    body: "community.attend.body",
    cta: "community.attend.cta",
    href: localizePath(lang, "/events"),
  },
  {
    icon: "mic",
    title: "community.speak.title",
    body: "community.speak.body",
    cta: "community.speak.cta",
    href: communityLinks.cfp,
  },
  {
    icon: "users",
    title: "community.host.title",
    body: "community.host.body",
    cta: "community.host.cta",
    href: communityLinks.sponsor,
  },
];

const en = lang === "en";
---

<div class="studio-page community-page">
  <AboutCommunity lang={lang} />
  <OrganizerCarousel lang={lang} />
  <section class="ed-wrap contribution-section">
    <div class="studio-toolbar">
      <h2>{t("community.participate.title")}</h2>
      <span class="studio-index">
        {en ? "FIND YOUR WAY IN" : "ENCUENTRA TU ESPACIO"} ↙
      </span>
    </div>
    <div class="contribution-list">
      {ways.map((way, i) => (
        <details class="contribution" open={i === 0}>
          <summary>
            <span>0{i + 1}</span>
            <h3>{t(way.title)}</h3>
            <Icon name={way.icon} size={32} />
            <b aria-hidden="true">+</b>
          </summary>
          <div class="contribution__body">
            <p>{t(way.body)}</p>
            {way.href ? (
              <a
                class="ed-button ed-button--primary"
                href={way.href}
                {...(way.href.startsWith("http")
                  ? { target: "_blank", rel: "noopener noreferrer" }
                  : {})}
              >
                {t(way.cta)} ↗
              </a>
            ) : (
              <button class="ed-button ed-button--primary" data-join-open>
                {t(way.cta)} ↗
              </button>
            )}
          </div>
        </details>
      ))}
    </div>
  </section>
  <section class="global-community ed-wrap">
    <GlobalNetwork lang={lang} />
    <div>
      <p class="ed-kicker">{t("community.global.eyebrow")}</p>
      <h2>{t("community.global.title")}</h2>
      <p>{t("community.global.body")}</p>
      <a
        class="ed-button ed-button--primary"
        href={globalLinks.home}
        target="_blank"
        rel="noopener noreferrer"
      >
        {t("community.global.site")} ↗
      </a>
      <a
        class="ed-text-link"
        href={globalLinks.platformcon}
        target="_blank"
        rel="noopener noreferrer"
      >
        PlatformCon ↗
      </a>
    </div>
  </section>
  <section class="ed-wrap conduct-section" id="code-of-conduct">
    <span aria-hidden="true">♡</span>
    <div>
      <p class="ed-kicker">EVERYONE BELONGS HERE</p>
      <h2>{t("community.coc.title")}</h2>
      <p>{t("community.coc.body")}</p>
    </div>
  </section>
</div>
