---
import { useTranslations, type Lang } from '@i18n/index';

interface Props { lang: Lang }

const t = useTranslations(Astro.props.lang);
---

<section class="about">
  <div class="container">
    <h1>{t('about.title')}</h1>
    <p>{t('about.body')}</p>
  </div>
</section>

<style>
  .about { padding-block: 4rem; }
  .about p { max-width: 65ch; color: var(--color-muted); }
</style>
