---
import Button from '@components/ui/Button.astro';
import EventCard from '@components/ui/EventCard.astro';
import { useTranslations, localizePath, type Lang } from '@i18n/index';
import { upcomingEvents } from '@data/events';
import { eventCardProps, eventPath } from '@modules/events/view';

interface Props { lang: Lang }

const { lang } = Astro.props;
const t = useTranslations(lang);
const next = upcomingEvents()[0];
---

<section class="container section section--tight">
  <div class="section-head">
    <div class="section-head__text">
      <div class="eyebrow">{t('home.next.eyebrow')}</div>
      <h2 class="h2">{t('home.next.title')}</h2>
    </div>
    <a href={localizePath(lang, '/events')} class="section-head__link">{t('home.next.all')}</a>
  </div>
  {next ? (
    <EventCard {...eventCardProps(next, lang)}>
      {next.status === 'soldout' ? (
        <Button slot="cta" variant="secondary" href={eventPath(next, lang)}>{t('events.detail')}</Button>
      ) : (
        <Button slot="cta" variant="green" href={eventPath(next, lang)}>{t('event.register')}</Button>
      )}
    </EventCard>
  ) : (
    <p class="muted">{t('home.next.empty')}</p>
  )}
</section>

<style>
  .section-head__link { font-weight: 600; }
</style>
