---
import { useTranslations, localizePath, type Lang } from '@i18n/index';

interface Props { lang: Lang }

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero">
  <div class="container">
    <h1>{t('home.hero.title')}</h1>
    <p>{t('home.hero.subtitle')}</p>
    <a class="hero__cta" href={localizePath(lang, '/about')}>{t('home.hero.cta')}</a>
  </div>
</section>

<style>
  .hero { padding-block: 5rem 3rem; }
  .hero h1 { font-size: clamp(2rem, 5vw, 3.25rem); line-height: 1.1; margin: 0 0 1rem; }
  .hero p { font-size: 1.2rem; color: var(--color-muted); max-width: 60ch; }
  .hero__cta {
    display: inline-block; margin-top: 1rem; padding: 0.75rem 1.25rem;
    background: var(--color-primary); color: #fff; border-radius: 8px; text-decoration: none;
  }
</style>
