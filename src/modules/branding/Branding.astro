---
import {asset} from '@lib/assets';
import {localizePath,type Lang} from '@i18n/index';
import './branding.css';
interface Props{lang:Lang}
const {lang}=Astro.props;const en=lang==='en';
const kit=(path:string)=>asset(`brand/kit/${path}`);
const palette=[['Electric Violet','#5B2EFF','DevEx'],['Andean Emerald','#00D96E','Platform'],['Cloud Lavender','#C4B5FD','Infrastructure'],['Peru Crimson','#E61530','Perú'],['Pure White','#FFFFFF','Ukuku'],['Deep Cosmos Navy','#090C20','Cloud']];
const logos=[['logo-horizontal-light','03-logotipos-horizontales',en?'Light background':'Fondo claro','light'],['logo-horizontal-dark','03-logotipos-horizontales',en?'Dark background':'Fondo oscuro','dark']];
const bears=[['oso-platform.webp',en?'A platform to embrace':'Una plataforma para abrazar'],['ukuku-seated-slide-rim.png',en?'Opening new paths':'Abriendo nuevos caminos'],['ukuku-flight.webp',en?'Exploring together':'Explorando juntos']];
const applications=[['pins-keychain','Pines y llavero','Pins & keychain'],['ukuku-plush','Ukuku de peluche','Ukuku plush'],['apparel-collection','Colección de prendas','Apparel collection'],['hoodie-shirt','Polera y polo','Hoodie & T-shirt'],['drinkware','Botella, vaso y taza','Bottle, tumbler & mug'],['event-identity','Identidad para encuentros','Event identity']];
const social=[['01-avatars-icons/github-avatar-500x500.png','GitHub avatar','500 × 500'],['01-avatars-icons/linkedin-avatar-800x800.png','LinkedIn avatar','800 × 800'],['02-banners-social/linkedin-cover-1584x396.png','LinkedIn cover','1584 × 396'],['02-banners-social/github-social-preview-1280x640.png','GitHub social preview','1280 × 640']];
---
<div class="brand-library">
 <header class="brand-hero ed-wrap">
  <div><p class="brand-eyebrow">PE / BRAND LIBRARY</p><h1>{en?'One community.':'Una comunidad.'}<br/><em>{en?'A shared identity.':'Una identidad compartida.'}</em></h1><p class="brand-lead">{en?'The visual language that connects us. Official logos, colors and resources to represent Platform Engineering Perú.':'El lenguaje visual que nos conecta. Logos oficiales, colores y recursos para representar a Platform Engineering Perú.'}</p><a class="brand-download" href={asset('brand/platform-engineering-peru-brand-kit.zip')} download>{en?'Download official kit':'Descargar kit oficial'} <span>↓ ZIP</span></a></div>
  <div class="brand-hero-art"><img src={asset('brand/official/mark.png')} alt="Platform Engineering Perú"/><span>DEVEX / PLATFORM / INFRA</span></div>
 </header>
 <nav class="brand-index ed-wrap" aria-label={en?'Brand library sections':'Secciones de branding'}>{[['logos','01','Logos'],['ukuku','02','Ukuku'],['palette','03',en?'Colors':'Colores'],['social','04','Social'],['applications','05',en?'Applications':'Aplicaciones'],['guidelines','06',en?'Guidelines':'Manual']].map(([id,n,label])=><a href={`#${id}`}><small>{n}</small>{label}<span>↘</span></a>)}</nav>
 <section class="brand-section ed-wrap" id="logos"><div class="brand-section-title"><p class="brand-eyebrow">01 / IDENTIDAD</p><h2>{en?'Our signature.':'Nuestra firma.'}</h2><p>{en?'Original files from the official brand kit.':'Archivos originales del kit de identidad oficial.'}</p></div><div class="brand-logo-grid">{logos.map(([name,folder,label,tone])=><article class="brand-asset"><div class={`brand-logo-preview ${tone}`}><img src={kit(`${folder}/${name}.svg`)} alt={label} loading="lazy"/></div><div class="brand-asset-caption"><h3>{label}</h3><a href={kit(`${folder}/${name}.svg`)} download aria-label={`${en?'Download':'Descargar'} ${label} SVG`}>SVG ↓</a>{folder==='03-logotipos-horizontales'&&<a href={kit(`${folder}/${name}.png`)} download aria-label={`${en?'Download':'Descargar'} ${label} PNG`}>PNG ↓</a>}</div></article>)}</div></section>
 <section class="brand-section ed-wrap" id="ukuku"><div class="brand-section-title"><p class="brand-eyebrow">02 / UKUKU</p><h2>{en?'The spirit of our community.':'El espíritu de la comunidad.'}</h2><p>{en?'Our spectacled bear: curiosity, care and paths that help others thrive.':'Nuestro oso de anteojos: curiosidad, cuidado y caminos para que otros prosperen.'}</p><a class="brand-text-link" href={localizePath(lang,'/mascot')}>{en?'Meet Ukuku':'Conoce la historia de Ukuku'} ↗</a></div><div class="brand-bear-grid">{bears.map(([file,title])=><article class="brand-asset"><div class="brand-bear-preview"><img src={asset(`illustrations/${file.replace(/\.png$/,'.webp')}`)} alt={`Ukuku: ${title}`} loading="lazy"/></div><div class="brand-asset-caption"><h3>{title}</h3><a href={asset(`illustrations/${file}`)} download aria-label={`${en?'Download':'Descargar'} Ukuku: ${title}`}>↓ {file.endsWith('png')?'PNG':'WEBP'}</a></div></article>)}</div></section>
 <section class="brand-section ed-wrap" id="palette"><div class="brand-section-title"><p class="brand-eyebrow">03 / COLOR</p><h2>{en?'Rooted in our identity.':'Colores que nos representan.'}</h2></div><div class="brand-palette">{palette.map(([name,hex,role])=><article><div style={`background:${hex}`}><span style={`color:${['#5B2EFF','#E61530','#090C20'].includes(hex)?'#fff':'#090C20'}`}>{role}</span></div><h3>{name}</h3><code>{hex}</code></article>)}</div></section>
 <section class="brand-section ed-wrap" id="social"><div class="brand-section-title"><p class="brand-eyebrow">04 / SOCIAL</p><h2>{en?'Where we connect.':'Donde nos encontramos.'}</h2></div><div class="brand-social-grid">{social.map(([file,title,size])=><article class="brand-asset"><div class="brand-social-preview"><img src={kit(file)} alt={title} loading="lazy"/></div><div class="brand-asset-caption"><h3>{title}<small>{size}</small></h3><a href={kit(file)} download aria-label={`${en?'Download':'Descargar'} ${title}`}>PNG ↓</a></div></article>)}</div></section>
 <section class="brand-section ed-wrap" id="applications"><div class="brand-section-title"><p class="brand-eyebrow">05 / {en?'BRAND APPLICATIONS':'APLICACIONES DE MARCA'}</p><h2>{en?'Our identity, beyond the screen.':'Nuestra identidad, fuera de la pantalla.'}</h2><p>{en?'Visual references for merchandise, apparel and community gatherings.':'Referencias visuales para merchandising, prendas y encuentros de la comunidad.'}</p></div><div class="brand-applications-grid">{applications.map(([file,es,english])=><article class="brand-asset"><a class="brand-application-preview" href={asset(`brand/applications/${file}.png`)} target="_blank" rel="noopener noreferrer" aria-label={`${en?'View':'Ver'} ${en?english:es}`}><img src={asset(`brand/applications/${file}.webp`)} alt={en?english:es} width="1200" height="896" loading="lazy"/></a><div class="brand-asset-caption"><h3>{en?english:es}</h3><a href={asset(`brand/applications/${file}.png`)} download aria-label={`${en?'Download':'Descargar'} ${en?english:es}`}>PNG ↓</a></div></article>)}</div></section>
 <section class="brand-guidelines ed-wrap" id="guidelines"><p class="brand-eyebrow">06 / BRAND GUIDELINES</p><h2>{en?'A consistent identity, wherever we meet.':'Una identidad coherente, donde nos encontremos.'}</h2><p>{en?'Consult the original manual for color values, asset inventory and brand references. Use the supplied versions to preserve the identity.':'Consulta el manual original con los valores de color, el inventario y las referencias de marca. Usa las versiones suministradas para preservar nuestra identidad.'}</p><a class="brand-download" href={kit('05-manual-y-readme/BRAND_GUIDELINES.md')} download>{en?'Download brand guidelines':'Descargar manual de identidad'} <span>↓ MD</span></a></section>
</div>
