---
import { opportunities } from "@data/opportunities";
import type { Lang } from "@i18n/index";
import "./opportunities.css";
interface Props {
  lang: Lang;
}
const lang = Astro.props.lang,
  en = lang === "en",
  total = opportunities.length;
const colors = ["#b5a4ff", "#93ddcd", "#f1b9ce", "#f1c18d", "#a7c8ef"];
const mode = (value: string) =>
  ({
    remote: en ? "Remote" : "Remoto",
    hybrid: en ? "Hybrid" : "Híbrido",
    onsite: en ? "On site" : "Presencial",
  })[value] ?? "";
const count = String(total).padStart(2, "0");
---

<section class="jobs" data-jobs>
  <header class="jobs-heading ed-wrap">
    <div>
      <p class="jobs-kicker">PE / NEXT CHAPTER</p><h1>
        {en ? "Build what" : "Construye lo que"}<br /><em
          >{en ? "comes next." : "viene después."}</em>
      </h1>
    </div><div>
      <p>
        {
          en
            ? "Your next golden path could start with a new team."
            : "Tu próximo golden path puede empezar con un nuevo equipo."
        }
      </p><span class="jobs-demo"
        >{
          en
            ? "Reviewed opportunities · apply at the original source"
            : "Oportunidades revisadas · postula en la fuente original"
        }</span>
    </div>
  </header>
  <div class="jobs-toolbar ed-wrap">
    <div
      role="group"
      aria-label={en ? "Work arrangement" : "Modalidad de trabajo"}
    >
      {
        [
          ["all", en ? "All" : "Todas"],
          ["remote", en ? "Remote" : "Remoto"],
          ["hybrid", en ? "Hybrid" : "Híbrido"],
          ["onsite", en ? "On site" : "Presencial"],
        ].map(([v, l]) => (
          <button
            data-job-filter={v}
            aria-pressed={v === "all"}
            disabled={!total}
          >
            {l}
          </button>
        ))
      }
    </div><button
      type="button"
      class="jobs-motion"
      data-job-motion
      aria-pressed="false"
      disabled={total < 2}
      aria-label={en
        ? "Pause automatic movement"
        : "Pausar movimiento automático"}
      ><span aria-hidden="true">Ⅱ</span> {en ? "Pause" : "Pausar"}</button
    ><span data-job-count aria-live="polite"
      >{count} / {en ? "OPPORTUNITIES" : "OPORTUNIDADES"}</span>
  </div>
  {
    total === 0 ? (
      <div class="jobs-empty ed-wrap" data-jobs-empty>
        <>
          <h2>
            {en
              ? "No reviewed opportunities are available right now."
              : "No hay oportunidades revisadas disponibles en este momento."}
          </h2>
          <p>
            {en
              ? "We show only active, unexpired roles from reviewed sources. Check back after the next editorial update."
              : "Mostramos solo puestos activos y vigentes de fuentes revisadas. Vuelve después de la próxima actualización editorial."}
          </p>
        </>
      </div>
    ) : (
      <>
        <div
          class="jobs-cylinder"
          data-job-stage
          tabindex="0"
          role="region"
          aria-label={
            en
              ? "Opportunity carousel. Use left and right arrows."
              : "Carrusel de oportunidades. Usa las flechas izquierda y derecha."
          }
        >
          <div class="jobs-orbit" aria-hidden="true" />
          {opportunities.map((job, i) => (
            <button
              class="job-card"
              data-job={i}
              data-mode={job.workplace}
              data-expires-at={job.expiresAt ?? ""}
              style={`--job-color:${colors[i % colors.length]}`}
              aria-label={`${en ? "View role" : "Ver oportunidad"}: ${job.title}`}
            >
              <span class="job-card__edge" aria-hidden="true" />
              <span class="job-card__front">
                <span class="job-card__top">
                  <span>PE / TALENT — {String(i + 1).padStart(2, "0")}</span>
                  <span>↗</span>
                </span>
                <span class="job-card__company">{job.company}</span>
                <strong>{job.title}</strong>
                <span class="job-card__tags">
                  {job.tags.map((t) => (
                    <span>{t}</span>
                  ))}
                </span>
                <span class="job-card__bottom">
                  <span>
                    {mode(job.workplace)}
                    {job.locations.length
                      ? " · " + job.locations.join(" · ")
                      : ""}
                  </span>
                  <span>
                    {String(i + 1).padStart(2, "0")} / {count}
                  </span>
                </span>
              </span>
              <span class="job-card__back" aria-hidden="true">
                <span>
                  THE NEXT
                  <br />
                  GOLDEN
                  <br />
                  PATH.
                </span>
                <small>
                  {job.company}
                  {job.seniority ? " / " + job.seniority : ""}
                </small>
              </span>
            </button>
          ))}
        </div>
        <>
          <div class="jobs-controls ed-wrap">
            <>
              <button
                data-job-prev
                aria-label={
                  en ? "Previous opportunity" : "Oportunidad anterior"
                }
                disabled={total < 2}
              >
                ←
              </button>
              <div aria-live="polite">
                <>
                  <span data-job-position>01 / {count}</span>
                  <h2 data-job-title>{opportunities[0]?.title}</h2>
                  <button class="job-open" data-job-open>
                    {en ? "Explore role" : "Explorar el rol"} ↗
                  </button>
                </>
              </div>
              <button
                data-job-next
                aria-label={en ? "Next opportunity" : "Siguiente oportunidad"}
                disabled={total < 2}
              >
                →
              </button>
            </>
          </div>
          <p class="jobs-hint">
            {en
              ? "Drag to explore · Arrow keys to navigate"
              : "Scroll o arrastra para explorar · Flechas para navegar"}
          </p>
        </>
        <p class="jobs-empty ed-wrap" data-job-filter-empty hidden>
          {en
            ? "No opportunities match this work arrangement."
            : "No hay oportunidades con esta modalidad de trabajo."}
        </p>
        <details class="jobs-list ed-wrap">
          <summary>
            {en ? "View accessible list" : "Ver oportunidades en lista"}
          </summary>
          {opportunities.map((j, i) => (
            <button data-job-list={i}>
              <span>{j.company}</span>
              <strong>{j.title}</strong>
              <span>{j.seniority ?? mode(j.workplace)} ↗</span>
            </button>
          ))}
        </details>
        <dialog
          class="job-detail"
          data-job-dialog
          aria-labelledby="job-detail-title"
        >
          <>
            <div class="job-detail__bar">
              <>
                <span>PE / OPPORTUNITIES</span>
                <button
                  data-job-close
                  aria-label={en ? "Close role" : "Cerrar oferta"}
                >
                  ×
                </button>
              </>
            </div>
            <div data-job-content />
          </>
        </dialog>
        {opportunities.map((j, i) => (
          <template data-job-template={i}>
            <div
              class="job-detail__hero"
              style={`--job-color:${colors[i % colors.length]}`}
            >
              <p>
                {j.company} / {en ? "REVIEWED SOURCE" : "FUENTE REVISADA"}
              </p>
              <h2 id="job-detail-title">{j.title}</h2>
              <div>
                {j.seniority && <span>{j.seniority}</span>}
                <span>{mode(j.workplace)}</span>
                {j.locations.map((location) => (
                  <span>{location}</span>
                ))}
              </div>
            </div>
            <div class="job-detail__body">
              <aside>
                <small>
                  {en ? "APPLY AT SOURCE" : "POSTULAR EN LA FUENTE"}
                </small>
                <a
                  class="job-open"
                  href={j.applyUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {en
                    ? "Apply at the original source"
                    : "Postular en la fuente original"}{" "}
                  ↗
                </a>
                <p>
                  {en
                    ? "Check the source for availability and application requirements."
                    : "Consulta la fuente para confirmar disponibilidad y requisitos de postulación."}
                </p>
                <div>
                  {j.tags.map((t) => (
                    <span>{t}</span>
                  ))}
                </div>
              </aside>
              <div>
                <h3>{en ? "Reviewed summary" : "Resumen editorial"}</h3>
                <p>{j.summary[lang]}</p>
                <p>
                  {en
                    ? "Original title and source language:"
                    : "Título original e idioma de la fuente:"}{" "}
                  {j.contentLanguage}
                </p>
                <p>
                  {en ? "Last verified:" : "Última verificación:"}{" "}
                  {new Date(j.lastVerifiedAt).toLocaleDateString(
                    en ? "en-US" : "es-PE",
                    { timeZone: "America/Lima" },
                  )}
                </p>
                {j.expiresAt && (
                  <p>
                    {en ? "Source expiration:" : "Vencimiento informado:"}{" "}
                    {new Date(j.expiresAt).toLocaleDateString(
                      en ? "en-US" : "es-PE",
                      { timeZone: "America/Lima" },
                    )}
                  </p>
                )}
                <a href={j.sourceUrl} target="_blank" rel="noopener noreferrer">
                  {en
                    ? "Read the complete role and hiring process"
                    : "Consultar la descripción completa y el proceso de selección"}{" "}
                  ↗
                </a>
              </div>
            </div>
          </template>
        ))}
      </>
    )
  }
</section>
<script>
  import "./opportunities";
</script>
