---
import Badge from '@components/ui/Badge.astro';
import Button from '@components/ui/Button.astro';
import Icon from '@components/ui/Icon.astro';
import type { IconName } from '@components/ui/icons';
import SpeakerCard from '@components/ui/SpeakerCard.astro';
import { localizePath, pick, useTranslations, type Lang } from '@i18n/index';
import { eventTone, isUpcoming, longDate, type CommunityEvent } from '@data/events';
import { speakerProps, speakersByName } from '@data/speakers';

interface Props {
  event: CommunityEvent;
  lang: Lang;
}

const { event, lang } = Astro.props;
const t = useTranslations(lang);
const upcoming = isUpcoming(event);
const status = upcoming ? t(`event.status.${event.status}` as const) : t('event.status.past');
const speakers = speakersByName(event.speakers);
const facts: { icon: IconName; text: string; detail?: string }[] = [
  { icon: 'calendar', text: longDate(event.date, lang) },
  { icon: 'clock', text: `${event.time}${event.endTime ? ` – ${event.endTime}` : ''} ${t('event.hours')}` },
  { icon: 'map-pin', text: `${event.venue}, ${pick(event.city, lang)}`, detail: event.address },
];
---

<div class="container detail">
  <div class="detail__main">
    <a href={localizePath(lang, '/events')} class="detail__back">{t('event.back')}</a>
    <div><Badge tone={eventTone(event)} dot>{status}</Badge></div>
    <h1 class="page-title">{pick(event.title, lang)}</h1>
    <p class="lead">{pick(event.description, lang)}</p>
    {speakers.length > 0 && (
      <>
        <div class="eyebrow detail__eyebrow">{t('event.speakers')}</div>
        <div class="detail__speakers">
          {speakers.map((s) => (
            <SpeakerCard {...speakerProps(s, lang)} />
          ))}
        </div>
      </>
    )}
  </div>

  <aside class="detail__aside">
    {facts.map((f) => (
      <div class="detail__fact">
        <Icon name={f.icon} class="detail__fact-icon" />
        <span class="detail__fact-text">
          <span class="mono">{f.text}</span>
          {f.detail && <span class="detail__fact-detail">{f.detail}</span>}
        </span>
      </div>
    ))}
    {event.organizer && (
      <div class="detail__organizer">{t('event.organizer')}: <strong>{event.organizer}</strong></div>
    )}
    {upcoming ? (
      <>
        {event.registerUrl ? (
          event.status === 'soldout' ? (
            <Button size="lg" variant="secondary" fullWidth href={event.registerUrl} external>{t('event.tickets')}</Button>
          ) : (
            <Button size="lg" variant="green" fullWidth href={event.registerUrl} external>{t('event.register')}</Button>
          )
        ) : (
          <Button size="lg" variant="green" fullWidth data-join-open>{t('event.register')}</Button>
        )}
        {event.status === 'soldout' && <span class="detail__note">{t('event.soldout.note')}</span>}
      </>
    ) : (
      <>
        {event.recording && (
          <Button size="lg" variant="secondary" fullWidth href={event.recording} external>
            <Icon slot="icon-left" name="play" size={16} />
            {t('events.recording')}
          </Button>
        )}
        <span class="detail__note">{t('event.past.note')}</span>
      </>
    )}
  </aside>
</div>

<style>
  .detail {
    padding-top: 48px; display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(280px, 1fr); gap: 48px;
  }
  .detail__main { display: flex; flex-direction: column; gap: 22px; }
  .detail__back { font-weight: 600; font-size: 14px; }
  .detail__eyebrow { margin-top: 12px; }
  .detail__speakers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .detail__aside {
    align-self: start; position: sticky; top: calc(var(--nav-h) + 24px);
    padding: 28px; border-radius: var(--radius-md);
    background: var(--bg-card); border: 1px solid var(--border-subtle);
    display: flex; flex-direction: column; gap: 18px;
  }
  .detail__fact { display: flex; gap: 12px; align-items: flex-start; font-size: 15px; }
  .detail__fact-text { display: flex; flex-direction: column; gap: 2px; }
  .detail__fact-detail { font-size: 13px; color: var(--fg-3); }
  .detail__organizer { font-size: 14px; color: var(--fg-2); padding-top: 14px; border-top: 1px solid var(--border-subtle); }
  .detail__fact :global(.detail__fact-icon) { color: var(--fg-accent-2); margin-top: 2px; }
  .detail__note { font-size: 13px; color: var(--fg-3); }
  @media (max-width: 860px) {
    .detail { grid-template-columns: 1fr; }
    .detail__aside { position: static; }
    .detail__speakers { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
