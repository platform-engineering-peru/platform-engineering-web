---
import EventPoster from "@components/ui/EventPoster.astro";
import Button from "@components/ui/Button.astro";
import Icon from "@components/ui/Icon.astro";
import type { IconName } from "@components/ui/icons";
import SpeakerCard from "@components/ui/SpeakerCard.astro";
import { localizePath, pick, useTranslations, type Lang } from "@i18n/index";
import { isUpcoming, longDate, type CommunityEvent } from "@data/events";
import { speakerProps, speakersByName } from "@data/speakers";
import { communityLinks } from "@data/site";

interface Props {
  event: CommunityEvent;
  lang: Lang;
}

const { event, lang } = Astro.props;
const t = useTranslations(lang);
const upcoming = isUpcoming(event);
const status = upcoming
  ? t(`event.status.${event.status}` as const)
  : t("event.status.past");
const speakers = speakersByName(event.speakers);
const facts: { icon: IconName; text: string; detail?: string }[] = [
  { icon: "calendar", text: longDate(event.date, lang) },
  {
    icon: "clock",
    text: `${event.time}${event.endTime ? ` – ${event.endTime}` : ""} ${t("event.hours")}`,
  },
  {
    icon: "map-pin",
    text: `${event.venue}, ${pick(event.city, lang)}`,
    detail: event.address,
  },
];

const en = lang === "en";
---

<div class="studio-page event-detail ed-wrap">
  <a class="detail-back" href={localizePath(lang, "/events")}>
    ← {t("event.back")}
  </a>
  <section class="event-detail__hero">
    <div>
      <p class="ed-kicker">
        <span class="ed-dot"></span>
        {status}
      </p>
      <h1>{pick(event.title, lang)}</h1>
      <p class="event-detail__description">{pick(event.description, lang)}</p>
      <div class="event-detail__edition">COMMUNITY / CLOUD NATIVE / PERÚ</div>
    </div>
    <div data-tilt>
      <EventPoster event={event} lang={lang} large />
    </div>
  </section>
  <section class="event-detail__body">
    <div>
      <p class="ed-kicker">
        {en ? "GOOD IDEAS HAVE A VOICE" : "LAS BUENAS IDEAS TIENEN VOZ"}
      </p>
      <h2>{t("event.speakers")}</h2>
      {speakers.length > 0 ? (
        <div class="detail-speakers">
          {speakers.map((s) => (
            <SpeakerCard {...speakerProps(s, lang)} />
          ))}
        </div>
      ) : (
        <p>{en ? "More details soon." : "Más detalles próximamente."}</p>
      )}
    </div>
    <aside class="event-pass">
      <div class="event-pass__title">
        <span>YOUR COMMUNITY PASS</span>
        <b>↗</b>
      </div>
      {facts.map((f) => (
        <div class="detail__fact">
          <Icon name={f.icon} class="detail__fact-icon" />
          <span class="detail__fact-text">
            <span class="mono">{f.text}</span>
            {f.detail && <span class="detail__fact-detail">{f.detail}</span>}
          </span>
        </div>
      ))}
      {event.organizer && (
        <div class="detail__organizer">
          {t("event.organizer")}: <strong>{event.organizer}</strong>
        </div>
      )}
      {upcoming ? (
        <>
          {event.registerUrl ? (
            event.status === "soldout" ? (
              <Button
                size="lg"
                variant="secondary"
                fullWidth
                href={event.registerUrl}
                external
              >
                {t("event.tickets")}
              </Button>
            ) : (
              <Button
                size="lg"
                variant="green"
                fullWidth
                href={event.registerUrl}
                external
              >
                {t("event.register")}
              </Button>
            )
          ) : (
            <Button size="lg" variant="green" fullWidth data-join-open>
              {t("event.register")}
            </Button>
          )}
          {event.status === "soldout" && (
            <span class="detail__note">{t("event.soldout.note")}</span>
          )}
          {communityLinks.cfp && (
            <a
              class="detail__cfp"
              href={communityLinks.cfp}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="mic" size={16} class="detail__cfp-icon" />
              <span>{t("event.cfp")}</span>
            </a>
          )}
        </>
      ) : (
        <>
          {event.recording && (
            <Button
              size="lg"
              variant="secondary"
              fullWidth
              href={event.recording}
              external
            >
              <Icon slot="icon-left" name="play" size={16} />
              {t("events.recording")}
            </Button>
          )}
          <span class="detail__note">{t("event.past.note")}</span>
        </>
      )}
      <div class="event-pass__barcode" aria-hidden="true"></div>
    </aside>
  </section>
</div>
