{
  "allOf": [
    {
      "if": {
        "properties": {
          "sourceNetwork": {
            "const": "other"
          }
        },
        "required": [
          "sourceNetwork"
        ]
      },
      "then": {
        "required": [
          "sourceNetworkLabel"
        ],
        "properties": {
          "sourceNetworkLabel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      }
    }
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "status",
    "updatedAt",
    "slug",
    "title",
    "description",
    "displayOrder",
    "body",
    "sourceNetwork",
    "sourceUrl",
    "sourcePublishedAt",
    "sourceLanguage",
    "tags"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "enum": [
        "published",
        "archived"
      ]
    },
    "updatedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "slug": {
      "type": "string",
      "maxLength": 120,
      "pattern": "^[a-z0-9]*(?:-[a-z0-9]+)*$",
      "minLength": 1
    },
    "title": {
      "type": "object",
      "properties": {
        "es-pe": {
          "type": "string",
          "maxLength": 120,
          "minLength": 1
        },
        "en": {
          "type": "string",
          "maxLength": 120,
          "minLength": 1
        }
      },
      "required": [
        "es-pe",
        "en"
      ],
      "additionalProperties": false
    },
    "description": {
      "type": "object",
      "properties": {
        "es-pe": {
          "type": "string",
          "maxLength": 4000,
          "minLength": 1
        },
        "en": {
          "type": "string",
          "maxLength": 4000,
          "minLength": 1
        }
      },
      "required": [
        "es-pe",
        "en"
      ],
      "additionalProperties": false
    },
    "displayOrder": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "body": {
      "type": "object",
      "properties": {
        "es-pe": {
          "type": "string",
          "maxLength": 20000,
          "minLength": 1
        },
        "en": {
          "type": "string",
          "maxLength": 20000,
          "minLength": 1
        }
      },
      "required": [
        "es-pe",
        "en"
      ],
      "additionalProperties": false
    },
    "sourceNetwork": {
      "type": "string",
      "enum": [
        "linkedin",
        "youtube",
        "facebook",
        "instagram",
        "x",
        "tiktok",
        "other"
      ]
    },
    "sourceNetworkLabel": {
      "type": "string",
      "maxLength": 120
    },
    "sourceUrl": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://(?![^/]*@)(?!localhost(?::|/|$)|[^/]*\\.(?:localhost|local|internal)(?::|/|$)|\\[|[0-9]{1,3}(?:\\.[0-9]{1,3}){3}(?::|/|$))[a-zA-Z0-9](?:[a-zA-Z0-9.-]*[a-zA-Z0-9])?(?::443)?(?:[/?#][^\\s]*)?$",
      "format": "uri"
    },
    "sourcePublishedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "sourceLanguage": {
      "type": "string",
      "enum": [
        "es-pe",
        "en",
        "und"
      ]
    },
    "tags": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    }
  }
}
