{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://platformengineering.pe/schemas/memory-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "slug",
    "status",
    "title",
    "description",
    "eventId",
    "capturedAt",
    "captureYear",
    "datePrecision",
    "media",
    "tags",
    "displayOrder",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 120
    },
    "status": {
      "enum": [
        "published",
        "archived"
      ]
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "es-pe",
        "en"
      ],
      "properties": {
        "es-pe": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        }
      }
    },
    "description": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "es-pe",
        "en"
      ],
      "properties": {
        "es-pe": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        }
      }
    },
    "eventId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "capturedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "captureYear": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        },
        {
          "type": "null"
        }
      ]
    },
    "datePrecision": {
      "enum": [
        "unknown",
        "year",
        "day"
      ]
    },
    "media": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "width",
          "height",
          "alt",
          "fit",
          "credit"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "path": {
            "type": "string",
            "pattern": "^(?:memories/community-0[1-5]\\.jpg|media/[a-f0-9]{12,64}/[a-z0-9][a-z0-9-]*\\.(?:webp|jpg|png))$"
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2560
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2560
          },
          "alt": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "es-pe",
              "en"
            ],
            "properties": {
              "es-pe": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "\\S"
              },
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "\\S"
              }
            }
          },
          "fit": {
            "enum": [
              "contain",
              "cover"
            ]
          },
          "credit": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "focalPoint": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "\\S"
      }
    },
    "displayOrder": {
      "type": "integer",
      "minimum": 0
    },
    "updatedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
