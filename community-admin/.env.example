# Local review. Keep all real credentials in ignored environment files or a secret store.
DATABASE_URL=postgresql://community_admin_local@127.0.0.1:55432/community_admin_local
DATABASE_SCHEMA=community_admin
PORT=4455
PUBLIC_ORIGIN=http://127.0.0.1:4455
DEV_FIXTURE_AUTH=0
# Optional local review only: use the already authenticated GitHub CLI account.
# Independent website vacancy PRs; keep disabled until the compatible renderer/schema is on main.
# This scope never enables social publishing or changes the Events editorial mode.
JOBS_WEBSITE_REPOSITORY=
JOBS_WEBSITE_BRANCH=main
JOBS_WEBSITE_WRITES=0
LOCAL_GH_AUTH=0
# Pin the numeric GitHub user ID in ignored local runtime config, never in source.
# LOCAL_GH_EXPECTED_SUBJECT=
# Nested layout: this app lives inside the website checkout.
# For a standalone app, set an explicit path to the trusted website checkout.
WEBSITE_CHECKOUT=..
STORAGE_BACKEND=local
# PRIVATE_STORAGE_DIR=.local/storage
# PRIVATE_KEY_DIR=.local/record-keys
# Real sign-in: numeric owner GitHub subject, independent of publishing App.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OWNER_SUBJECT=
# Connector and backup encryption keys must each decode to 32 random bytes; keep separate.
# CONNECTOR_ENCRYPTION_KEY=
# BACKUP_ENCRYPTION_KEY=
INTEGRATIONS_LIVE_ENABLED=false
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY_FILE=.local/secrets/github-app.pem
# GITHUB_WEBHOOK_SECRET=
# WEBSITE_REPO=owner/repository
# GITHUB_REQUIRED_CHECKS=Validate website
# GITHUB_REQUIRED_APPROVALS=1
# GITHUB_API_VERSION=2022-11-28
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REDIRECT_URI=http://127.0.0.1:4455/api/integrations/linkedin/oauth/callback
# LINKEDIN_API_VERSION=
# LINKEDIN_SCOPES=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REDIRECT_URI=http://127.0.0.1:4455/api/integrations/youtube/oauth/callback
# YOUTUBE_SCOPES=
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# VIDEO_STORAGE_QUOTA_BYTES=10737418240

# Optional distributed editorial mode, initially Events only. Existing SQL records remain legacy local data.
# No activation or remote write occurs merely by installing/migrating the application.
EDITORIAL_MODE=local
# EDITORIAL_REPOSITORY=owner/repository
EDITORIAL_BRANCH=main
# Explicit per-install opt-in for proposal branches/PRs. Never merges the approved branch.
EDITORIAL_REMOTE_WRITES=0
# Uses this operator's existing gh credential store. No GitHub App secret is needed by this mode.
